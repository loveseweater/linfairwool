# ============================================================
# LINFAIR 独立站 · Cloudflare Pages 响应头
# 规则冲突时以下方为准（Cloudflare Pages 后者优先）
# ============================================================

# ---------- 静态资源：必须校验 ----------
# ⚠️ vite.config.ts 使用固定文件名（assets/index.js 无 content hash），
#    且 public/ 内提交的预渲染 HTML 引用这些固定路径，因此这里**不能**用 immutable/max-age——
#    否则访客浏览器会长期执行旧 bundle，新文章水合后显示 "Post Not Found"（2026-09-24 实测事故）。
/assets/*
  Cache-Control: public, max-age=0, must-revalidate

# 图片同样使用稳定路径；新增图片是新文件名不受影响，但**替换同名图片必须加 ?v=N 破缓存**
# （logo.png 曾因同名替换导致全站破图 + 浏览器一年期旧缓存）
/images/*
  Cache-Control: public, max-age=86400

/logo.png
  Cache-Control: public, max-age=0, must-revalidate

# logo.webp 为新文件名（显示用，og:image 仍用 PNG）；logo 变更时用新文件名而非覆盖
/logo.webp
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=0, must-revalidate

# ---------- 全局：安全头 + HTML 不缓存 ----------
/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  # CSP 已于 2026-09-22 实测 8 个页面零违规后转为强制模式
  # 白名单：GTM/GA(脚本+上报)、Google Fonts(字体)、EmailJS(表单)、YouTube(嵌入视频)、https 图片
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://api.emailjs.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
